# ─── Drumzon — monthly drops model ─── #
# Copy this file to .env.local and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser.

# Production URL (no trailing slash). Used in metadata, canonical, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://drumzon.com

# ─── Stripe Payment Links ─── #
# Create one Payment Link per drop, per currency, in the Stripe Dashboard.
# After payment, set Stripe's redirect to:
#   https://drumzon.com/thank-you?purchase=pack         (for one-time drops)
#   https://drumzon.com/thank-you?purchase=inner-circle (for Inner Circle)
#
# Per-drop one-time purchase URLs (USD + EUR variants).
# Naming convention: NEXT_PUBLIC_BUY_{DROP_SLUG}_{CURRENCY}
NEXT_PUBLIC_BUY_SAHARA_USD=
NEXT_PUBLIC_BUY_SAHARA_EUR=

# Inner Circle subscription Payment Link (Stripe Subscription, recurring).
# Same URL works for both USD and EUR — Stripe shows local currency
# based on buyer's country if you enable Adaptive Pricing on the Link.
NEXT_PUBLIC_INNER_CIRCLE_URL=

# ─── Kit (formerly ConvertKit) ─── #
# Form action URL for the Free Afrohouse MIDI starter pack lead magnet.
# Format: https://app.kit.com/forms/{FORM_ID}/subscriptions
# In Kit: set the form to apply tag `free-midi-pack-lead` and an incentive
# email with the MIDI download link.
NEXT_PUBLIC_KIT_FORM_ACTION=

# ─── Audio preview ─── #
# SoundCloud URL or hosted MP3 for the Sahara drop preview/demo beat.
# When empty, AudioPreview shows a styled placeholder.
NEXT_PUBLIC_SAHARA_PREVIEW_URL=
NEXT_PUBLIC_SOUNDCLOUD_URL=
