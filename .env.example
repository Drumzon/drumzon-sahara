# ─── Drumzon Pro — Environment Variables ─── #
# Copy this file to .env.local and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser.
# Server-only secrets MUST NOT have the NEXT_PUBLIC_ prefix.
#
# See SETUP.md for the full step-by-step runbook.

# ─── Public ─── #
# Production URL (no trailing slash). Used for metadata, canonical, Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://drumzon.com

# Sahara demo audio URL. Direct .mp3 or .wav URL (Cloudflare R2 public bucket
# recommended). When empty, AudioPlayer renders a placeholder card.
NEXT_PUBLIC_SAHARA_DEMO_URL=

# ─── Supabase ─── #
# Project URL + anon key — both safe to expose to browser (RLS enforced).
# Get from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER-ONLY. Never expose. Used by webhook handler.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ─── #
# Test keys for dev (`sk_test_...`), live keys for prod (`sk_live_...`).
# Get from Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=

# Webhook signing secret. Get from Stripe Dashboard → Developers → Webhooks
# → endpoint settings. Different for test vs live.
STRIPE_WEBHOOK_SECRET=

# Price IDs (4 total — create in Stripe Dashboard → Products → Drumzon Pro).
# Founding tier: €7/month or €70/year (2 months free).
STRIPE_PRICE_FOUNDING_MONTHLY=
STRIPE_PRICE_FOUNDING_YEARLY=
# Standard tier: €14.95/month or €149/year (~2 months free).
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=

# ─── Kit (ConvertKit) ─── #
# API secret — SERVER-ONLY. Get from Kit → Account Settings → Account → API.
KIT_API_SECRET=
# Tag IDs — create two tags in Kit (e.g. "drumzon-founding", "drumzon-standard")
# then grab their numeric IDs from the tag URL.
KIT_TAG_FOUNDING=
KIT_TAG_STANDARD=

# ─── Cloudflare R2 (file delivery, future M8 portal) ─── #
# Add these when you wire the member portal download flow.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=drumzon-drops
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
