# ─── Drumzon Vol. 1: Sahara ─── #
# Copy this file to .env.local and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser.

# Production URL (no trailing slash). Used in metadata, canonical, OG, sitemap.
# Locally you can leave it as is; on Vercel set it to your real domain.
NEXT_PUBLIC_SITE_URL=https://drumzon.com

# Checkout URL for the paid pack (Gumroad / Lemon Squeezy / Stripe Payment Link).
# Hero "Get the Pack" CTA points here. If empty, button links to "#".
NEXT_PUBLIC_BUY_URL=

# Kit (formerly ConvertKit) form action URL for the lead-magnet email capture.
# Format: https://app.kit.com/forms/{FORM_ID}/subscriptions
# In Kit, set the form's "Success URL" to https://drumzon.com/thank-you
NEXT_PUBLIC_KIT_FORM_ACTION=

# SoundCloud track URL for the hero audio preview embed.
# Format: https://soundcloud.com/{your-name}/{track-slug}
# When empty, hero shows a styled placeholder with this var name.
NEXT_PUBLIC_SOUNDCLOUD_URL=
